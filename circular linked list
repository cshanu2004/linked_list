#include<iostream>
using namespace std;
class Node{
public:
int data;
Node *next;
Node(int value){
    data = value;
    next= NULL;

}
};
Node *addfirst(Node *head){
    int n;
    cout<<"Enter the data";
    cin>>n;
    Node *new_node=new Node(n);
    if (head==NULL){
        head = new_node;
        return head;

    }
    else{
        head = new_node;
        new_node->next=head;
        return new_node;

    }
}
Node *addlast(Node *head){
    
    int n;
    cout<<"Enter the data";
    cin>>n;
    Node *new_node=new Node(n);
    Node *tail= head;

    if(head==NULL){
        head = new_node;
        return head;

    }
    while(tail->next!=head){
        tail=tail->next;

    }
    tail->next=new_node;
    new_node->next=head;
    head= new_node;
    return head;

}
