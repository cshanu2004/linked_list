    Node *next,*prev;
    Node(int value){
         data = value;
         next = NULL;
         prev =NULL;


    }
};
Node *addfirst(Node *head){
     int n;
     cout<<"Enter the data";
     cin>>n;
     Node *new_node =new Node(n);
     if(head==NULL){
        head = new_node;
        return head;

     }
     else{
       
        new_node->next = head;
        head = new_node;
        head->prev = new_node->prev;
     }
}
