#include <iostream>
using namespace std;
class Node{
    public:
    int data;
    Node *next,*prev;
    Node(int value){
     data = value;
     next = NULL;
     prev = NULL;
    }
};
Node *addfirst(Node *head){
int n;
cout<<"Enter the data";
cin>>n;
Node *new_node=new Node(n);
if(head==NULL){
    head=new_node;

}
else{
    head->prev=new_node;
    new_node->next=head;
    head=new_node;
}
return head;
}
Node *addlast(Node *head ){
    int n;
    cout<<"Enter the data";
    cin>>n;
    Node *tail=head;
    Node *new_node=new Node(n);
    if(head==NULL){
        head=new_node;

    }
    else{
        while(tail->next!=NULL){
            tail=tail->next;

        }
        tail->next=new_node;
        new_node->prev=tail;
    }
     return head;
}
Node *addpos(Node *head){
    int pos,n;
    cout<<"Enter the data";
    cin>>n;
    Node *new_node=new Node(n);
    cout<<"Enter the position";
    cin>>pos;
    if(pos==1){
        return addfirst(head);
    }
    Node *tail = head;

    for(int i=2;i<pos-1 && tail!=NULL;i++ ){
    tail=tail->next;

    }
      tail->next= new_node;
      new_node->next=tail->next;
      new_node->prev=tail;
      if(new_node->next!=NULL){
        new_node->next->prev=new_node;

      }
      return head;

}
